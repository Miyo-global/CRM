# ═══════════════════════════════════════════════════════════════
# MIYO GLOBAL CRM — Environment Variables
# Copy this file to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ─── Database (required) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/miyoglobal_crm

# ─── Auth (required) ────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Security ───────────────────────────────────────────────────
# Optional: set to 1 if you run `pnpm start` locally with production-style URLs
# (no localhost in NEXTAUTH_URL / NEXT_PUBLIC_APP_URL) and the browser forces https://.
DISABLE_HSTS=
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
CRON_SECRET=
WEBHOOK_SECRET=

# ─── Company identity ───────────────────────────────────────────
# Printed on offer letters, payslips, termination letters and NDAs.
# Set the registered legal entity, e.g. "Miyo Global Pvt Ltd".
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Miyo Global
# Incorporation date (YYYY-MM-DD). This is the earliest selectable joining
# date in HR onboarding — a value later than a real hire date rejects that hire.
NEXT_PUBLIC_COMPANY_ESTABLISHED_DATE=2024-10-27
# Registered office. Fills the {{orgAddress}} token in NDA and appointment
# templates and the letterhead fallback. Leave blank rather than stale — the
# NDA states it as the company's registered office.
NEXT_PUBLIC_COMPANY_ADDRESS=
# Fallback contact number on generated documents when the org has none set.
NEXT_PUBLIC_COMPANY_PHONE=
# Public marketing site, linked from the careers pages.
NEXT_PUBLIC_COMPANY_WEBSITE_URL=https://miyoglobal.com

# ─── Company contact addresses ──────────────────────────────────
HR_NOTIFICATION_EMAIL=hr@example.com
SUPPORT_EMAIL=support@example.com
INFO_EMAIL=info@example.com

# ─── Locale, currency, timezone ─────────────────────────────────
# Defaults used wherever there is no organisation context (emails, generated
# PDFs, cron jobs), and the starting values for new organisations. Individual
# orgs can still override currency/timezone in Settings → Organisation.
# The currency symbol is derived from these — do not hardcode it.
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# ─── HR policy (optional — defaults shown) ──────────────────────
# Leave entitlements in days per year.
NEXT_PUBLIC_CASUAL_LEAVE_DAYS_PER_YEAR=12
NEXT_PUBLIC_SICK_LEAVE_DAYS_PER_YEAR=6
NEXT_PUBLIC_MAX_LEAVE_DAYS_PER_REQUEST=30
# Working pattern, used for attendance and payroll proration.
NEXT_PUBLIC_WORKING_HOURS_PER_DAY=8
NEXT_PUBLIC_WORKING_DAYS_PER_WEEK=5
NEXT_PUBLIC_HOLIDAY_WORK_FULL_DAY_HOURS=9
# Amounts, in NEXT_PUBLIC_DEFAULT_CURRENCY.
NEXT_PUBLIC_SALARY_MIN=0
NEXT_PUBLIC_SALARY_MAX=10000000
NEXT_PUBLIC_LOAN_MAX_AMOUNT=1000000
NEXT_PUBLIC_BONUS_MAX_AMOUNT=100000
# Flat monthly professional tax. India levies this per state, so the amount
# and whether it applies at all depend on where staff are engaged. 0 disables.
NEXT_PUBLIC_PROFESSIONAL_TAX=200
# Days a rejected candidate is blocked from reapplying.
NEXT_PUBLIC_REJECTION_COOLDOWN_DAYS=30

# ─── Email — ZeptoMail by Zoho (default) ────────────────────────
# zeptomail | sendgrid. Leave as zeptomail unless you are falling back.
EMAIL_PROVIDER=zeptomail
# ZeptoMail console → Mail Agents → <your agent> → SMTP & API → Send Mail Token.
# Paste the token only; a leading "Zoho-enczapikey " is stripped automatically.
ZEPTOMAIL_TOKEN=
# Optional. Override only if your Zoho account lives outside the default (US)
# data centre — api.zeptomail.eu | .in | .com.au | .ca | .jp | .sa
# e.g. ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_URL=
# Optional. Custom bounce address configured on the Mail Agent.
ZEPTOMAIL_BOUNCE_ADDRESS=

# From/Reply-To used by every outbound email. The From domain MUST be a domain
# verified in ZeptoMail, otherwise sends are rejected with TM_3201.
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Miyo Global
EMAIL_REPLY_TO=

# ─── Email — SendGrid (fallback, set EMAIL_PROVIDER=sendgrid) ───
SENDGRID_API_KEY=

# ─── AI / LLM ───────────────────────────────────────────────────
# Gemini (AI chat assistant)
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI (lead scoring, email generation, smart features — GPT-4o-mini)
OPENAI_API_KEY=

# ─── Google OAuth (Calendar / Meet integration) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show Google sign-in button on signin page
NEXT_PUBLIC_GOOGLE_ENABLED=

# ─── Cloudflare R2 — file uploads (chat, avatars, documents) ────
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Redis (Upstash) — session cache, rate limits (optional) ────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Inngest — background jobs (optional) ──────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Team chat — Ably realtime (optional; polls if unset) ──────
ABLY_API_KEY=

# ─── Web Push (VAPID) ───────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must match
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@miyoglobal.com

# ─── Razorpay — Subscription billing (optional) ────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Integrations (optional) ────────────────────────────────────
BIOMETRIC_API_KEY=
BIOMETRIC_ORG_ID=
SLACK_WEBHOOK_URL=

# ─── E-signature (optional) ─────────────────────────────────────
DOCUMENSO_API_URL=
DOCUMENSO_API_TOKEN=
ESIGN_WEBHOOK_SECRET=
DOCUSIGN_WEBHOOK_SECRET=

# ─── Job-board webhooks (optional) ──────────────────────────────
LINKEDIN_WEBHOOK_SECRET=
INDEED_WEBHOOK_SECRET=
NAUKRI_WEBHOOK_SECRET=

# ─── SMS — Twilio (optional) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Bot protection — Cloudflare Turnstile (optional) ───────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Behaviour tuning (optional) ────────────────────────────────
# Minutes past shift start before attendance is marked late (IST).
ATTENDANCE_LATE_CUTOFF_MINUTES_IST=
# Both must match — how long a chat message stays editable, in ms.
CHAT_MESSAGE_EDIT_WINDOW_MS=
NEXT_PUBLIC_CHAT_MESSAGE_EDIT_WINDOW_MS=
# Writable output root for generated payslips. Set this when the app runs on a
# read-only filesystem; defaults to ./generated.
GENERATED_OUTPUT_DIR=

# ─── Sentry — error tracking & performance (optional) ──────────
# Leave SENTRY_AUTH_TOKEN unset to disable Sentry build integration.
# Without DSN the SDK initializes as a no-op (safe in dev / preview).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── App URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_QR_REDIRECT_BASE_URL=

# ─── Test / Dev helpers ─────────────────────────────────────────
ALLOW_TEST_EMAIL=
TEST_EMAIL=
# Required by the sample/preview mail scripts — they refuse to run without it
# rather than falling back to a hardcoded inbox.
TEST_EMAIL_TO=
# Target address for scripts/_check-user-org.ts
TARGET_EMAIL=
# Display name used by scripts/send-all-emails-test.ts
TEST_EMAIL_NAME=

# ─── Seed data (for pnpm db:seed) ───────────────────────────────
# Required by scripts/seed.ts — the CEO/admin account it creates.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=ChangeMe@123
# Domain for scripts/seed-test-accounts.ts demo logins (ceo@, hr@, sales@ …).
SEED_TEST_DOMAIN=miyoglobal.test
# Existing user recorded as the creator of seeded templates and questions.
SEED_CREATED_BY_EMAIL=
SEED_DEMO_PASSWORD=
SEED_PASSWORD=
SEED_ORG_SLUG=
NEW_PASSWORD=
OWNER_EMAIL=
ALLOW_CLEAR_REMOTE_DB=
# Read by destructive maintenance scripts — keep this OUT of local .env files.
PROD_DATABASE_URL=
